*.jks
*.keystore
release-application-key

# Android Studio / IntelliJ
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# JVM heap dumps (Gradle OutOfMemory) - can be hundreds of MB
*.hprof

# macOS
.DS_Store

# Third-party protocol reference (eds-ox, contains other people's code/APKs;
# linked in README instead of redistributed)
eds-ox-main.zip
