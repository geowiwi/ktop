<?xml version="1.0" encoding="utf-8"?>
<!--
  Names and descriptions: @string/field_* (values/, values-de/).
  Field set = Ki2's (https://github.com/valterc/ki2, MIT License,
  karoo_extension_info.xml): same names, descriptions and graphical flags.
  rear_gear / shift_count keep their existing ktop typeIds (they are Ki2's
  "Rear Gear" / "Shift Count" and are already placed in ride profiles).
  Not ported: Ki2 "Shifting Mode" (Di2 synchro mode, no Wheeltop equivalent).
  Kept from ktop (not in Ki2): the four battery-voltage fields.
-->
<ExtensionInfo
    displayName="@string/extension_name"
    icon="@mipmap/ic_launcher"
    id="wheeltop"
    fitFile="true"
    scansDevices="true">

    <!-- ===== Ki2 fields ===== -->
    <DataType
        description="@string/field_shifting_battery_percentage_desc"
        displayName="@string/field_shifting_battery_percentage"
        icon="@drawable/ic_battery"
        typeId="DATATYPE_SHIFTING_BATTERY_PERCENTAGE" />

    <DataType
        description="@string/field_gear_ratio_desc"
        displayName="@string/field_gear_ratio"
        graphical="true"
        icon="@drawable/ic_gear"
        typeId="DATATYPE_GEAR_RATIO" />

    <DataType
        description="@string/field_gears_index_desc"
        displayName="@string/field_gears_index"
        graphical="true"
        icon="@drawable/ic_gear"
        typeId="DATATYPE_GEARS_INDEX" />

    <DataType
        description="@string/field_gears_size_desc"
        displayName="@string/field_gears_size"
        graphical="true"
        icon="@drawable/ic_gear"
        typeId="DATATYPE_GEARS_SIZE" />

    <DataType
        description="@string/field_front_gear_index_desc"
        displayName="@string/field_front_gear_index"
        graphical="true"
        icon="@drawable/ic_gear"
        typeId="DATATYPE_FRONT_GEAR_INDEX" />

    <DataType
        description="@string/field_front_gear_size_desc"
        displayName="@string/field_front_gear_size"
        graphical="true"
        icon="@drawable/ic_gear"
        typeId="DATATYPE_FRONT_GEAR_SIZE" />

    <DataType
        description="@string/field_rear_gear_desc"
        displayName="@string/field_rear_gear"
        graphical="true"
        icon="@drawable/ic_gear"
        typeId="rear_gear" />

    <DataType
        description="@string/field_rear_gear_size_desc"
        displayName="@string/field_rear_gear_size"
        graphical="true"
        icon="@drawable/ic_gear"
        typeId="DATATYPE_REAR_GEAR_SIZE" />

    <DataType
        description="@string/field_shift_count_desc"
        displayName="@string/field_shift_count"
        graphical="true"
        icon="@drawable/ic_gear"
        typeId="shift_count" />

    <DataType
        description="@string/field_front_shift_count_desc"
        displayName="@string/field_front_shift_count"
        graphical="true"
        icon="@drawable/ic_gear"
        typeId="DATATYPE_FRONT_SHIFT_COUNT" />

    <DataType
        description="@string/field_rear_shift_count_desc"
        displayName="@string/field_rear_shift_count"
        graphical="true"
        icon="@drawable/ic_gear"
        typeId="DATATYPE_REAR_SHIFT_COUNT" />

    <DataType
        description="@string/field_visual_gears_index_desc"
        displayName="@string/field_visual_gears_index"
        graphical="true"
        icon="@drawable/ic_gear"
        typeId="DATATYPE_VISUAL_GEARS_INDEX" />

    <DataType
        description="@string/field_visual_gears_size_desc"
        displayName="@string/field_visual_gears_size"
        graphical="true"
        icon="@drawable/ic_gear"
        typeId="DATATYPE_VISUAL_GEARS_SIZE" />

    <DataType
        description="@string/field_visual_gears_detailed_desc"
        displayName="@string/field_visual_gears_detailed"
        graphical="true"
        icon="@drawable/ic_gear"
        typeId="DATATYPE_VISUAL_GEARS_DETAILED" />

    <DataType
        description="@string/field_visual_drivetrain_index_desc"
        displayName="@string/field_visual_drivetrain_index"
        graphical="true"
        icon="@drawable/ic_gear"
        typeId="DATATYPE_VISUAL_DRIVETRAIN_INDEX" />

    <DataType
        description="@string/field_visual_drivetrain_size_desc"
        displayName="@string/field_visual_drivetrain_size"
        graphical="true"
        icon="@drawable/ic_gear"
        typeId="DATATYPE_VISUAL_DRIVETRAIN_SIZE" />

    <DataType
        description="@string/field_visual_bike_battery_desc"
        displayName="@string/field_visual_bike_battery"
        graphical="true"
        icon="@drawable/ic_battery"
        typeId="DATATYPE_VISUAL_BIKE_BATTERY" />

    <!-- ===== ktop battery voltages (not in Ki2) ===== -->
    <DataType
        description="@string/field_rear_batt_v_desc"
        displayName="@string/field_rear_batt_v"
        graphical="true"
        icon="@drawable/ic_battery"
        typeId="rear_batt_v" />
    <DataType
        description="@string/field_left_batt_v_desc"
        displayName="@string/field_left_batt_v"
        graphical="true"
        icon="@drawable/ic_battery"
        typeId="left_batt_v" />
    <DataType
        description="@string/field_right_batt_v_desc"
        displayName="@string/field_right_batt_v"
        graphical="true"
        icon="@drawable/ic_battery"
        typeId="right_batt_v" />
    <DataType
        description="@string/field_front_batt_v_desc"
        displayName="@string/field_front_batt_v"
        graphical="true"
        icon="@drawable/ic_battery"
        typeId="front_batt_v" />
</ExtensionInfo>
